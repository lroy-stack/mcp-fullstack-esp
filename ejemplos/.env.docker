# Configuración para Docker Stack Enigma
# Usar esta configuración cuando se ejecute contra el stack Docker local

# URLs del Stack Docker
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=REDACTED

# URLs internas (para desarrollo)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=REDACTED
SUPABASE_SERVICE_ROLE_KEY=REDACTED

# Base de datos
DATABASE_URL=postgresql://postgres:EncryptionConAlma23@localhost:5432/postgres

# Configuración de aplicación
NODE_ENV=development
SITE_URL=http://localhost:3000

# Credenciales de prueba
TEST_ADMIN_EMAIL=admin@enigmaconalma.com
TEST_ADMIN_PASSWORD=REDACTED

# Esquemas disponibles
SUPABASE_SCHEMAS=public,restaurante,personal,crm,operaciones,comunicaciones,notificaciones

# URLs del Dashboard Supabase
SUPABASE_DASHBOARD_URL=http://localhost:8005
GESTOR_URL=http://localhost:8090

# Real-time configuration
REALTIME_URL=ws://localhost:8000/realtime/v1